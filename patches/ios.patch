diff --git a/crates/horizon-client/src/game/ios.rs b/crates/horizon-client/src/game/ios.rs
new file mode 100644
index 000000000..ceb9305fc
--- /dev/null
+++ b/crates/horizon-client/src/game/ios.rs
@@ -0,0 +1,110 @@
+//! iOS uses the same mappings, interaction and text paths as desktop input.
+use super::*;
+
+pub(super) fn ios_touch_events(touch: &winit::event::Touch) -> Vec<WindowEvent> {
+    use winit::event::TouchPhase;
+    let mut events = vec![WindowEvent::CursorMoved {
+        device_id: touch.device_id,
+        position: touch.location,
+    }];
+    if touch.phase != TouchPhase::Moved {
+        events.push(WindowEvent::MouseInput {
+            device_id: touch.device_id,
+            state: if touch.phase == TouchPhase::Started {
+                ElementState::Pressed
+            } else {
+                ElementState::Released
+            },
+            button: MouseButton::Left,
+        });
+    }
+    events
+}
+impl Game<'_> {
+    pub(super) fn ios_suspend(&mut self) {
+        horizon_ios_platform::background(true);
+        self.keys.clear();
+        self.physical_keys.clear();
+        self.left = false;
+        self.right = false;
+        self.capture(false);
+        if self.screen == Screen::Playing {
+            self.screen = Screen::Paused;
+            self.pause_menu = true;
+        }
+        if let Some(server) = &self.integrated {
+            // Save on the authoritative server thread, including region-writer completion.
+            let saved = server.call(|game| game.save_game().map_err(|e| e.to_string()));
+            if !matches!(saved, Some(Ok(()))) {
+                log::error!("iOS background save failed: {saved:?}");
+            }
+            server.set_paused(true);
+        }
+        horizon_client::logging::flush();
+        horizon_ios_platform::background(false);
+    }
+    pub(super) fn ios_input(&mut self, event_loop: &dyn EventLoopCtl) -> Result<()> {
+        let playing = self.screen == Screen::Playing && self.title.is_none() && !self.dialog_open();
+        if let Some(window) = &self.window {
+            horizon_ios_platform::attach(window, false);
+        }
+        horizon_ios_platform::playing(playing);
+        while let Some(input) = horizon_ios_platform::poll() {
+            match input.kind {
+                1 => {
+                    let key = match input.code {
+                        0 => KeyCode::KeyA,
+                        1 => KeyCode::KeyD,
+                        2 => KeyCode::KeyW,
+                        3 => KeyCode::KeyS,
+                        4 => KeyCode::Space,
+                        5 => KeyCode::ShiftLeft,
+                        6 => KeyCode::ControlLeft,
+                        7 => KeyCode::KeyE,
+                        8 => KeyCode::Escape,
+                        9 => KeyCode::KeyT,
+                        10 => KeyCode::KeyQ,
+                        13 => KeyCode::Backspace,
+                        14 => KeyCode::Enter,
+                        _ => continue,
+                    };
+                    // Canonical actions avoid user keyboard remaps changing touch controls.
+                    self.mapped_key(key, input.x != 0.0, false)?;
+                }
+                2 if playing => match input.code {
+                    20 => self.play_mouse(MouseButton::Left, input.x != 0.0)?,
+                    21 => self.play_mouse(MouseButton::Right, input.x != 0.0)?,
+                    22 if input.x != 0.0 => self.selected = (self.selected + 8) % 9,
+                    23 if input.x != 0.0 => self.selected = (self.selected + 1) % 9,
+                    _ => {}
+                },
+                2 if input.code == 21 => {
+                    if let Some(window) = &self.window {
+                        self.handle_window_event(
+                            event_loop,
+                            window.id(),
+                            WindowEvent::MouseInput {
+                                device_id: DeviceId::dummy(),
+                                state: if input.x != 0.0 {
+                                    ElementState::Pressed
+                                } else {
+                                    ElementState::Released
+                                },
+                                button: MouseButton::Right,
+                            },
+                            input_trace::InputOrigin::User,
+                        );
+                    }
+                }
+                3 if playing => self.mouse.on_move(0.0, 0.0, input.x, input.y, true, true),
+                5 => {
+                    self.keys.clear();
+                    self.left = false;
+                    self.right = false;
+                }
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+}
